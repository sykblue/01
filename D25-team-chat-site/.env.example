# 복사해서 .env.local 로 저장 (로컬) · 배포는 Vercel › Settings › Environment Variables 에 같은 이름으로
# OpenAI 호환 /chat/completions 주소면 무엇이든 돼요.

# ① 로컬 Ollama (기본값 — 아무것도 안 넣어도 이 값)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# ② 배포용 예시 — 클라우드 API (키는 여기 말고 Vercel 환경변수에만)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3-32b
# LLM_API_KEY=여기에_키

# ④ n8n 연결 (로컬) — 질문을 n8n 워크플로로 보내고, 대시보드는 p2-team 데이터를 읽기
# N8N_CHAT_URL=http://localhost:5678/webhook/d25-team-chat/chat
# TEAM_DATA_DIR=../D25-mcp/p2-team

# ③ LLM 없이 규칙 기반으로만 (데모 · 키 없을 때)
# LLM_DISABLED=1
